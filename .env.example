# Скопируйте в .env или выполните npm run setup. Не коммитьте заполненный .env.
PORT=3016
HOST_PORT=3016
PUBLIC_ISSUER_URL=https://auth.example.com
# setup создаёт случайные значения. Пароль БД используйте без URL-спецсимволов.
POSTGRES_PASSWORD=
ADMIN_API_TOKEN=
# Resend: ключ своего аккаунта и адрес с подтверждённым доменом отправителя.
RESEND_API_KEY=
EMAIL_FROM=auth@example.com
EMAIL_FROM_NAME=Auth Service
EMAIL_APP_NAME=Моё приложение
# Пусто = Google выключен. В Google Console укажите origin сервиса.
GOOGLE_CLIENT_ID=
CLIENTS_JSON=[]
MIGRATE_ON_BOOT=true
SSO_COOKIE_SECURE=true
# Не меньше 30: приложение обновляет токен не чаще раза в 15 секунд.
ACCESS_TTL_SECONDS=900
ID_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
SSO_TTL_SECONDS=2592000
# Имена cookie входа и защиты форм. Менять нужно редко: после смены у
# пользователей один раз пропадёт вход в браузере.
# SSO_COOKIE_NAME=sso
# CSRF_COOKIE_NAME=csrf
# Только запуск без базы (разработка): ключ подписи берётся отсюда.
# RSA_PRIVATE_KEY и RSA_PUBLIC_KEY (PEM, переводы строк как \n),
# SIGNING_KEY_KID (имя ключа). Нет ключей: KEY_AUTOGENERATE=true создаст
# временный при старте. С базой (как в Docker Compose) ключи живут в базе,
# ротация описана в docs/DEPLOY.md.
# RSA_PRIVATE_KEY=
# RSA_PUBLIC_KEY=
# SIGNING_KEY_KID=
# KEY_AUTOGENERATE=false
# nginx на хосте обращается к контейнеру через этот Docker gateway.
TRUST_PROXY=loopback,172.30.240.1
DOCKER_SUBNET=172.30.240.0/24
DOCKER_GATEWAY=172.30.240.1
# Широкий бюджет для серверных приложений, пользователи которых имеют один IP.
TOKEN_RATE_LIMIT=10000
# Писем с кодом с одного IP в час (класс или офис за одним адресом делят его).
CODE_REQUEST_PER_IP_HOURLY=100
# Неверных кодов с одного IP в час; верный код не считается. По умолчанию
# равен CODE_REQUEST_PER_IP_HOURLY. Для группы 150 человек: оба по 300.
# CODE_VERIFY_PER_IP_HOURLY=100
# Входов через Google с одного IP за 15 минут.
GOOGLE_SIGNIN_PER_IP_15MIN=60
LOG_LEVEL=info
# Вне Docker Compose укажите свои адреса:
# DATABASE_URL=postgres://authv3:password@localhost:5432/authv3
# REDIS_URL=redis://localhost:6379
