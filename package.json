{
  "name": "auth-service-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "node --env-file-if-exists=.env ./dist/src/adapters/db/migrate-cli.js",
    "rotate-key": "node --env-file-if-exists=.env ./dist/src/adapters/db/rotate-key-cli.js",
    "revoke-key": "node --env-file-if-exists=.env ./dist/src/adapters/db/revoke-key-cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:module": "tsc -p module/tsconfig.json --noEmit && tsc -p tests/module/tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "setup": "node scripts/setup.mjs",
    "client": "node --env-file-if-exists=.env scripts/client.mjs",
    "check": "npm run typecheck && npm run typecheck:module && npm test && npm run build",
    "sync-examples": "node scripts/sync-examples.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/formbody": "^8.0.2",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.12.7",
    "google-auth-library": "^10.9.0",
    "ioredis": "^5.11.1",
    "jose": "^5.9.6",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "resend": "^6.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "hono": "^4.13.13",
    "pg-mem": "^3.0.14",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.4"
  },
  "description": "Self-hosted OIDC authentication service with email codes, Google sign-in and Next.js/Hono integrations",
  "license": "MIT"
}
